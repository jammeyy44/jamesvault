# Flask Application Settings
SECRET_KEY=your_secret_key_here_change_in_production
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/gameapis
# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_REDIS_URL=redis://localhost:6379/0

# TwoCaptcha API
CAPTCHA_API_KEY=your_2captcha_api_key

# --- JamesVault site -------------------------------------------------------
JV_ENV=development               # production enforces a non-default SECRET_KEY and secure cookies
JV_COOKIE_SECURE=false           # true behind HTTPS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=                    # leave empty: the Next.js app proxies /api/v1 (same origin)
BRAND_NAME=stakesweep.net
BRAND_SUPPORT_EMAIL=
BRAND_MIN_AGE=18
# Feature flags. Keep wallet/launch OFF until licensing, payments and provider contracts are verified.
JV_ENABLE_WALLET=false
JV_ENABLE_GAME_LAUNCH=false
JV_ENABLE_WHEEL=true
JV_ENABLE_REGISTRATION=true
# Password-reset email (without SMTP_HOST nothing is sent; in development the link is logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
PASSWORD_RESET_MINUTES=30
# Comma-separated emails pre-created as superadmin by `python seed_site.py` (they set a password via Forgot password)
ADMIN_EMAILS=jammeyy44@gmail.com

# --- Wallet & payments (Paydora) ---------------------------------------------
JV_ENABLE_GAME_ACCOUNTS=false    # create provider game logins with the live adapters (unverified)
JV_ENABLE_CASH_REQUESTS=false    # only for the non-wallet staff-confirmed Add Cash path
JV_SANDBOX=false                 # development only: fake accounts + payments. Refused when JV_ENV=production
JV_RATE_LIMITS=true              # false only for automated browser tests. Refused in production
PAYDORA_BASE_URL=https://cpcs.paydora.net/api/v1
PAYDORA_API_KEY=                 # pk_... (secret)
PAYDORA_WEBHOOK_SECRET=          # whsec_... (secret)
TRUSTED_PROXY_COUNT=0            # reverse proxies appending to X-Forwarded-For (needed for correct customer IPs)
CASHOUT_MIN=50
CASHOUT_MAX=500
CASH_MIN=5
CASH_MAX=500
PROVIDER_ACCOUNT_KEY=            # encrypts provider passwords + game logins; set it, and do not lose it
DEPOSIT_MIN=1                    # bounds for deposit methods that accept any amount
DEPOSIT_MAX=1000
DEPOSIT_TASK_MIN=20              # Bonus Zone "daily deposit" task threshold (dollars)

# Telegram live chat + deposit alerts (see app/services/telegram.py). Keep the real values only in your private .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEPOSIT_TOPIC_ID=
